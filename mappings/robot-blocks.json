  "unmappedModels": {
    "MT4_UART": "Python labels this E4 / MT4, while the downloaded Arduino MT4.cpp disagrees with MT4.h. Confirm E4_UART versus MT4_UART before mapping.",
    "Harobot_UART": "No corresponding class in the supplied library.",
    "Miromax_UART": "No corresponding class in the supplied library."
  },
  "rules": {
    "setup_robot": {
      "target": "variables_set + arduino_class + arduino_instance_call",
      "function": "class declaration + init",
      "status": "mapped",
      "note": "Declare the corresponding robot class and call init(). Transport configuration stays separate; computer/simulated ports are not reused."
    },
    "robot_homing": {
      "function": "homing + waitIdle",
      "status": "mapped",
      "note": "Includes both calls; preserves the Python homing block wait."
    },
    "robot_zero": {
      "function": "zero",
      "status": "mapped"
    },
    "robot_speed": {
      "function": "setMotionSpeed",
      "status": "mapped",
      "note": "Python emits F, matching setMotionSpeed; motionSpeedRatio emits H and is not equivalent."
    },
    "write_coordinate": {
      "function": "movePose",
      "status": "mapped",
      "note": "Preserves all model axes. MOTION 0/1/2 map to MOVEP/MOVEL/JUMP (G00/G01/G05); not MOVEJ, which is 1 in this library."
    },
    "write_angle": {
      "function": "moveJoints",
      "status": "mapped",
      "note": "Use the Arduino moveJoints implementation (G01), as selected for Arduino Blockly; preserve absolute/incremental mode and all model joint values."
    },
    "robot_wait_idle": {
      "function": "waitIdle",
      "status": "mapped"
    },
    "robot_send_msg": {
      "function": "sendMsg",
      "status": "mapped",
      "note": "Append CRLF like Python. Set askEn false to keep the send-only behavior."
    },
    "robot_delay": {
      "function": "delay",
      "status": "mapped",
      "note": "Convert seconds to milliseconds."
    },
    "robot_pump": {
      "function": "setEndtPump",
      "status": "mapped",
      "note": "Preserve mode 0/1/2 -> PWM 0/1000/500."
    },
    "robot_gripper": {
      "function": "setEndtGripper",
      "status": "mapped",
      "note": "Preserve mode 0/1/2 -> PWM 0/40/60; block labels and SDK docstrings differ, so mapping follows actual commands."
    },
    "robot_three_finger": {
      "function": "setEndtPump",
      "status": "mapped",
      "note": "Python generator calls pump, not gripper."
    },
    "robot_conveyor": {
      "function": "moveExjDist",
      "status": "pending",
      "note": "Arduino always uses M21/G00 and scales distance by exj_ratio; Python preserves G00/G01. Units/mode need confirmation."
    },
    "robot_homing_wait": {
      "function": "parent homing wait",
      "status": "legacy",
      "note": "The obsolete decorative child has no Python generator output; it is not converted independently."
    }
  }
}
